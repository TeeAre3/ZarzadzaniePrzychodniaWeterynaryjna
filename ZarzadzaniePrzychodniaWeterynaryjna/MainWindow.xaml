<Window x:Class="ZarzadzaniePrzychodniaWeterynaryjna.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:ZarzadzaniePrzychodniaWeterynaryjna.ViewModels"
        xmlns:views="clr-namespace:ZarzadzaniePrzychodniaWeterynaryjna.Views"
        Title="Zarządzanie Przychodnią Weterynaryjną" 
        Height="750" Width="1100" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="TopMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource MenuBackgroundBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10,10,5,10"/>
            <Setter Property="Padding" Value="20,10"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#ECF0F1" Height="65">
            <Button Content="Terminarz" Command="{Binding ShowScheduleCommand}" Style="{StaticResource TopMenuButtonStyle}" Margin="15,10,5,10"/>
            <Button Content="Klienci i Pacjenci" Command="{Binding ShowClientsCommand}" Style="{StaticResource TopMenuButtonStyle}"/>
            <Button Content="Katalog Usług" Command="{Binding ShowCatalogCommand}" Style="{StaticResource TopMenuButtonStyle}"/>
            <Button Content="Podsumowanie (Finanse)" Command="{Binding ShowStatisticsCommand}" Style="{StaticResource TopMenuButtonStyle}"/>
        </StackPanel>

        <ContentControl Content="{Binding CurrentView}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type viewmodels:ScheduleViewModel}">
                    <views:ScheduleView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:ConsultationViewModel}">
                    <views:ConsultationView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:ClientsPatientsViewModel}">
                    <views:ClientsPatientsView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:CatalogViewModel}">
                    <views:CatalogView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:StatisticsViewModel}">
                    <views:StatisticsView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </DockPanel>
</Window>