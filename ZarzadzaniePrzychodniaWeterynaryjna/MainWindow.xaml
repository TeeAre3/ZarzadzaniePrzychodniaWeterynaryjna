<Window x:Class="ZarzadzaniePrzychodniaWeterynaryjna.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:ZarzadzaniePrzychodniaWeterynaryjna.ViewModels"
        xmlns:views="clr-namespace:ZarzadzaniePrzychodniaWeterynaryjna.Views"
        Title="Zarządzanie Przychodnią Weterynaryjną" Height="700" Width="1050">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <TabControl Margin="10">
        <TabItem Header="Klienci i Pacjenci" FontSize="14">
            <views:KlienciPacjenciView DataContext="{Binding KlienciVM}" />
        </TabItem>

        <TabItem Header="Katalog (Usługi / Towary)" FontSize="14">
            <views:KatalogView DataContext="{Binding KatalogVM}" />
        </TabItem>
    </TabControl>
</Window>