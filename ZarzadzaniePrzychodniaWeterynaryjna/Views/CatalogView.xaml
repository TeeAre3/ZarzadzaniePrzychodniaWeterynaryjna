<UserControl x:Class="ZarzadzaniePrzychodniaWeterynaryjna.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ZarzadzaniePrzychodniaWeterynaryjna.Converters">

    <UserControl.Resources>
        <conv:DecimalConverter x:Key="KropkaNaPrzecinekConv" />
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,15,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Dodaj pozycję" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" />

                <TextBlock Text="Nazwa:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="3" />

                <TextBlock Text="Typ:" Margin="0,0,0,2"/>
                <ComboBox SelectedIndex="{Binding NewItemTypeIndex}" Margin="0,0,0,10" Padding="3">
                    <ComboBoxItem Content="Usługa" />
                    <ComboBoxItem Content="Towar" />
                    <ComboBoxItem Content="Lek" />
                    <ComboBoxItem Content="Inne" />
                </ComboBox>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NewItemTypeIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Jednostka miary (szt, ml, op):" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding NewItemUnit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="3" />
                </StackPanel>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Cena (Netto):" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NewItemPrice, Converter={StaticResource KropkaNaPrzecinekConv}, UpdateSourceTrigger=LostFocus}" Padding="3" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="VAT (%):" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NewItemVAT, Converter={StaticResource KropkaNaPrzecinekConv}, UpdateSourceTrigger=LostFocus}" Padding="3" />
                    </StackPanel>
                </Grid>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NewItemTypeIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Czas trwania (minuty):" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding NewItemDurationMin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="3" />
                </StackPanel>

                <Button Content="Dodaj do katalogu" Command="{Binding AddCatalogItemCommand}" Padding="8" Background="#0078D7" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>

        <DataGrid Grid.Column="1" ItemsSource="{Binding CatalogList}" AutoGenerateColumns="False" IsReadOnly="True" RowBackground="#F5F5F5" AlternatingRowBackground="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Typ" Binding="{Binding ItemType}" Width="70"/>
                <DataGridTextColumn Header="Jedn." Binding="{Binding Unit}" Width="60"/>
                <DataGridTextColumn Header="Cena Netto" Binding="{Binding Price, StringFormat={}{0:N2} zł}" Width="90"/>
                <DataGridTextColumn Header="VAT" Binding="{Binding VAT, StringFormat={}{0}%}" Width="50"/>
                <DataGridTextColumn Header="Czas (min)" Binding="{Binding DurationMin}" Width="80"/>
                <DataGridTemplateColumn Width="70" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Usuń" 
                                    Command="{Binding DataContext.RemoveCatalogItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}" 
                                    Background="{StaticResource DangerBrush}" 
                                    Foreground="White" 
                                    Padding="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>