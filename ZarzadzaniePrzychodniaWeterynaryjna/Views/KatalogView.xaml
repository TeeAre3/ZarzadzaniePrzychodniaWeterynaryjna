<UserControl x:Class="ZarzadzaniePrzychodniaWeterynaryjna.Views.KatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ZarzadzaniePrzychodniaWeterynaryjna.Converters">

    <UserControl.Resources>
        <conv:DecimalConverter x:Key="KropkaNaPrzecinekConv" />
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,15,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Dodaj pozycję" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" />

                <TextBlock Text="Nazwa:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding NowyKatalogNazwa, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="3" />

                <TextBlock Text="Typ:" Margin="0,0,0,2"/>
                <ComboBox SelectedIndex="{Binding NowyKatalogTypIndex}" Margin="0,0,0,10" Padding="3">
                    <ComboBoxItem Content="Usługa" />
                    <ComboBoxItem Content="Towar" />
                    <ComboBoxItem Content="Lek" />
                </ComboBox>

                <TextBlock Text="Jednostka (np. szt, ml, dawka, usługa):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding NowyKatalogJednostka, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="3" />

                <TextBlock Text="Cena ewidencyjna (netto):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding NowyKatalogCena, UpdateSourceTrigger=LostFocus, Converter={StaticResource KropkaNaPrzecinekConv}}" Margin="0,0,0,10" Padding="3" />

                <TextBlock Text="Stawka VAT (%):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding NowyKatalogVAT, UpdateSourceTrigger=LostFocus, Converter={StaticResource KropkaNaPrzecinekConv}}" Margin="0,0,0,10" Padding="3" />

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NowyKatalogTypIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Czas trwania (minuty):" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding NowyKatalogCzasMin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="3" />
                </StackPanel>

                <Button Content="Dodaj do katalogu" Command="{Binding DodajKatalogCommand}" Padding="8" Background="#0078D7" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>

        <DataGrid Grid.Column="1" ItemsSource="{Binding KatalogLista}" AutoGenerateColumns="False" IsReadOnly="True" RowBackground="#F5F5F5" AlternatingRowBackground="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*"/>
                <DataGridTextColumn Header="Typ" Binding="{Binding Typ}" Width="70"/>
                <DataGridTextColumn Header="Jedn." Binding="{Binding JednostkaMiary}" Width="60"/>
                <DataGridTextColumn Header="Cena Netto" Binding="{Binding CenaEwidencyjna, StringFormat={}{0:N2} zł}" Width="90"/>
                <DataGridTextColumn Header="VAT" Binding="{Binding VAT, StringFormat={}{0}%}" Width="50"/>
                <DataGridTextColumn Header="Czas (min)" Binding="{Binding CzasTrwaniaWMin}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>