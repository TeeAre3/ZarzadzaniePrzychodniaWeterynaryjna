<UserControl x:Class="ZarzadzaniePrzychodniaWeterynaryjna.Views.KlienciPacjenciView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Margin="0,0,15,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Nowy Klient" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" />
                    <TextBlock Text="Typ klienta:" FontWeight="Bold" Margin="0,0,0,2"/>
                    <ComboBox SelectedIndex="{Binding WybranyTypKlienta}" Margin="0,0,0,15" Padding="5">
                        <ComboBoxItem Content="Osoba prywatna" />
                        <ComboBoxItem Content="Firma" />
                        <ComboBoxItem Content="Osoba prywatna + Firma" />
                    </ComboBox>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WybranyTypKlienta}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Imię:" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NoweImie, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="3" />
                        <TextBlock Text="Nazwisko:" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NoweNazwisko, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="3" />
                    </StackPanel>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WybranyTypKlienta}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Nazwa firmy:" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NowaNazwaFirmy, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="3" />
                    </StackPanel>
                    <TextBlock Text="Telefon:" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding NowyTelefon, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="3" />
                    <TextBlock Text="Email (*):" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding NowyEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="3" />
                    <Button Content="Zapisz Klienta" Command="{Binding DodajWlascicielaCommand}" Padding="8" Background="#0078D7" Foreground="White" FontWeight="Bold" Cursor="Hand" />
                </StackPanel>
            </ScrollViewer>

            <DataGrid Grid.Column="1" ItemsSource="{Binding WlascicieleLista}" SelectedItem="{Binding WybranyWlasciciel, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowBackground="#F5F5F5" AlternatingRowBackground="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="30"/>
                    <DataGridTextColumn Header="Imię" Binding="{Binding Imie}" />
                    <DataGridTextColumn Header="Nazwisko" Binding="{Binding Nazwisko}" />
                    <DataGridTextColumn Header="Nazwa Firmy" Binding="{Binding NazwaFirmy}" />
                    <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                    <DataGridTextColumn Header="Rejestracja" Binding="{Binding DataRejestracji, StringFormat=dd.MM.yyyy}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Separator Grid.Row="1" Margin="0,5,0,15"/>

        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WybranyWlasciciel}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Margin="0,0,15,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Zarejestruj Zwierzę" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                    <TextBlock Text="Imię (*):" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding NoweZwierzeImie, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Padding="3" />
                    <TextBlock Text="Gatunek (*):" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding NoweZwierzeGatunek, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Padding="3" />
                    <TextBlock Text="Rasa:" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding NoweZwierzeRasa, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Padding="3" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Płeć (*):" Margin="0,0,0,2"/>
                            <ComboBox SelectedIndex="{Binding NoweZwierzePlecIndex}" Padding="3">
                                <ComboBoxItem Content="Samica" />
                                <ComboBoxItem Content="Samiec" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Waga (kg):" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding NoweZwierzeWaga, UpdateSourceTrigger=PropertyChanged}" Padding="3" />
                        </StackPanel>
                    </Grid>
                    <Button Content="Dodaj Zwierzę" Command="{Binding DodajZwierzeCommand}" Margin="0,15,0,0" Padding="8" Background="#28A745" Foreground="White" FontWeight="Bold" Cursor="Hand" />
                </StackPanel>
            </ScrollViewer>

            <DataGrid Grid.Column="1" ItemsSource="{Binding ZwierzetaLista}" AutoGenerateColumns="False" IsReadOnly="True" >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="30"/>
                    <DataGridTextColumn Header="Imię" Binding="{Binding Imie}" Width="*"/>
                    <DataGridTextColumn Header="Gatunek" Binding="{Binding Gatunek}" />
                    <DataGridTextColumn Header="Rasa" Binding="{Binding Rasa}" />
                    <DataGridTextColumn Header="Płeć" Binding="{Binding Plec}" />
                    <DataGridTextColumn Header="Waga" Binding="{Binding Waga, StringFormat={}{0} kg}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>