<UserControl x:Class="ZarzadzaniePrzychodniaWeterynaryjna.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,15,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Rezerwacja Wizyty" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" />
                <TextBlock Text="1. Właściciel:" FontWeight="Bold" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding ClientsList}" SelectedItem="{Binding SelectedClient}" DisplayMemberPath="DisplayName" Margin="0,0,0,10" Padding="5" />
                <TextBlock Text="2. Zwierzę:" FontWeight="Bold" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding PatientsList}" SelectedItem="{Binding SelectedPatient}" DisplayMemberPath="Name" Margin="0,0,0,15" Padding="5" />
                <TextBlock Text="3. Powód wizyty:" FontWeight="Bold" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding ServicesList}" SelectedItem="{Binding SelectedService}" DisplayMemberPath="Name" Margin="0,0,0,15" Padding="5" />

                <TextBlock Text="Data wizyty:" Margin="0,0,0,2"/>
                <DatePicker SelectedDate="{Binding ScheduledDate}" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Godzina (GG:MM):" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Padding="3" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Czas (min):" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding EstimatedDurationMin, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Padding="3" />
                    </StackPanel>
                </Grid>

                <Button Content="Zapisz do terminarza" Command="{Binding AddAppointmentCommand}" Padding="8" Background="#FF9800" Foreground="White" FontWeight="Bold"/>
                <Button Content="Usuń wybraną" Command="{Binding RemoveAppointmentCommand}" Margin="0,10,0,0" Padding="8" Background="#DC3545" Foreground="White" FontWeight="Bold"/>
                <Separator Margin="0,20,0,20"/>
                <Button Content="Rozpocznij Wizytę" Command="{Binding StartConsultationCommand}" Padding="10" Background="#17A2B8" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </ScrollViewer>

        <DataGrid Grid.Column="1" ItemsSource="{Binding AppointmentList}" SelectedItem="{Binding SelectedAppointment, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowBackground="#FFF8E1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Data" Binding="{Binding ScheduledDate, StringFormat=dd.MM.yyyy HH:mm}" Width="120" />
                <DataGridTextColumn Header="Pacjent" Binding="{Binding Patient.Name}" Width="100" />
                <DataGridTextColumn Header="Powód" Binding="{Binding Reason}" Width="*" />
                <DataGridTextColumn Header="Czas (min)" Binding="{Binding EstimatedDurationMin}" Width="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>