<UserControl x:Class="ZarzadzaniePrzychodniaWeterynaryjna.Views.HarmonogramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,15,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Rezerwacja Wizyty" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" />

                <TextBlock Text="1. Wybierz Właściciela:" FontWeight="Bold" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding WlascicieleLista}" 
                          SelectedItem="{Binding WybranyWlasciciel}" 
                          DisplayMemberPath="Nazwisko" 
                          Margin="0,0,0,10" Padding="5" />

                <TextBlock Text="2. Wybierz Zwierzę:" FontWeight="Bold" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding ZwierzetaLista}" 
                          SelectedItem="{Binding WybraneZwierze}" 
                          DisplayMemberPath="Imie" 
                          IsEnabled="{Binding WybranyWlasciciel, Converter={x:Null}, ConverterParameter=Reverse}"
                          Margin="0,0,0,15" Padding="5" />

                <Separator Margin="0,5,0,15"/>

                <TextBlock Text="3. Główny powód wizyty:" FontWeight="Bold" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding UslugiLista}" 
                          SelectedItem="{Binding WybranaUsluga}" 
                          DisplayMemberPath="Nazwa" 
                          Margin="0,0,0,15" Padding="5" />

                <TextBlock Text="Data wizyty:" FontWeight="Bold" Margin="0,0,0,2"/>
                <DatePicker SelectedDate="{Binding PlanowanaData}" Margin="0,0,0,10" Padding="3" />

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Godzina (HH:MM):" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding PlanowanaGodzina, UpdateSourceTrigger=PropertyChanged}" Padding="3" ToolTip="Np. 14:30" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Wyliczony czas:" Margin="0,0,0,2" Foreground="#555" />
                        <TextBox Text="{Binding SzacowanyCzasMin, Mode=OneWay}" 
                                 IsReadOnly="True" 
                                 Background="#E9ECEF"
                                 Padding="3" ToolTip="Czas wyliczony i zaokrąglony przez system" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Zapisz" 
                            Command="{Binding DodajRezerwacjeCommand}" 
                            Padding="10" Margin="0,0,5,0" Background="#FF9800" Foreground="White" FontWeight="Bold" Cursor="Hand" />

                    <Button Grid.Column="1" Content="Usuń wybraną" 
                            Command="{Binding UsunRezerwacjeCommand}" 
                            Padding="10" Margin="5,0,0,0" Background="#DC3545" Foreground="White" FontWeight="Bold" Cursor="Hand" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <DataGrid Grid.Column="1" 
                  ItemsSource="{Binding HarmonogramLista}" 
                  SelectedItem="{Binding WybranaRezerwacja, Mode=TwoWay}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  SelectionMode="Single"
                  RowBackground="#FFF8E1"
                  AlternatingRowBackground="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr Rezerwacji" Binding="{Binding Id}" Width="100"/>
                <DataGridTextColumn Header="Data i Godzina" Binding="{Binding PlanowanaDataRozpoczecia, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                <DataGridTextColumn Header="Pacjent (Zwierzę)" Binding="{Binding Zwierze.Imie}" Width="150" />
                <DataGridTextColumn Header="Czas (min)" Binding="{Binding SzacowanyCzasTrwania}" Width="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusWizyty}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>