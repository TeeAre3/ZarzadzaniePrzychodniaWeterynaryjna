<UserControl x:Class="ZarzadzaniePrzychodniaWeterynaryjna.Views.ConsultationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ZarzadzaniePrzychodniaWeterynaryjna.Converters">

    <UserControl.Resources>
        <conv:DecimalConverter x:Key="KropkaNaPrzecinekConv" />
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Historia Pacjenta" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox ItemsSource="{Binding VisitHistory}" Height="600" BorderBrush="#DDDDDD" Background="#F9F9F9">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5,5,5,15">
                            <TextBlock Text="{Binding VisitDate, StringFormat=dd.MM.yyyy HH:mm}" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="{Binding Diagnosis}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,0,0,0">

                <TextBlock Text="Opis Wywiadu:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewInterview, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="80" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Rozpoznanie (Diagnoza):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewDiagnosis, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Zalecenia dla właściciela:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewRecommendations, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Padding="5" Margin="0,0,0,20"/>

                <Separator Margin="0,0,0,20" />

                <TextBlock Text="Rozliczenie wizyty (Użyte leki i usługi):" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableCatalog}" SelectedItem="{Binding SelectedCatalogItem}" DisplayMemberPath="Name" Margin="0,0,10,0" Padding="5"/>
                    <TextBox Grid.Column="1" Text="{Binding NewQuantity, Converter={StaticResource KropkaNaPrzecinekConv}, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0" Padding="5" ToolTip="Ilość"/>
                    <Button Grid.Column="2" Content="Dodaj" Command="{Binding AddItemCommand}" Background="#007BFF" Foreground="White" FontWeight="Bold"/>
                </Grid>

                <DataGrid ItemsSource="{Binding AddedItems}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" MaxHeight="200" Margin="0,0,0,15">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pozycja" Binding="{Binding CatalogItem.Name}" Width="*"/>
                        <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="60"/>
                        <DataGridTextColumn Header="Cena Netto" Binding="{Binding AppliedPrice, StringFormat={}{0:N2} zł}" Width="90"/>
                        <DataGridTextColumn Header="VAT" Binding="{Binding AppliedVAT, StringFormat={}{0}%}" Width="60"/>

                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Usuń" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#DC3545" Foreground="White" Padding="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
                    <TextBlock Text="Suma do zapłaty (brutto):" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding TotalSum, StringFormat={}{0:N2} zł}" FontSize="20" FontWeight="Bold" Foreground="#28A745" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="Zakończ wizytę i zapisz" Command="{Binding EndConsultationCommand}" Padding="15" Background="#28A745" Foreground="White" FontSize="16"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>