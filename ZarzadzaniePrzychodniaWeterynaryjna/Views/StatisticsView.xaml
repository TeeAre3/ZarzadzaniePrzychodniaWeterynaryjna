<UserControl x:Class="ZarzadzaniePrzychodniaWeterynaryjna.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="280"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Całkowity Przychód Przychodni: " Foreground="White" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N2} zł}" Foreground="#28A745" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Border Background="White" CornerRadius="8">
                <Grid Margin="10">
                    <TextBlock Text="Przychód z ostatnich 7 dni" FontWeight="Bold" Foreground="#333333" Margin="10,0,0,0"/>
                    <lvc:CartesianChart Series="{Binding ChartSeries}" XAxes="{Binding XAxis}" YAxes="{Binding YAxis}" Margin="0,25,0,0" TooltipPosition="Top" />
                </Grid>
            </Border>
        </Grid>

        <DataGrid Grid.Row="2" ItemsSource="{Binding InvoiceList}" AutoGenerateColumns="False" IsReadOnly="True" RowBackground="#F9F9F9" AlternatingRowBackground="White" BorderBrush="#DDDDDD">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr Wizyty" Binding="{Binding AppointmentId}" Width="80"/>
                <DataGridTextColumn Header="Data Zakończenia" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                <DataGridTextColumn Header="Klient" Binding="{Binding Client}" Width="*"/>
                <DataGridTextColumn Header="Pacjent" Binding="{Binding Patient}" Width="*"/>
                <DataGridTextColumn Header="Kwota Brutto" Binding="{Binding TotalAmmount, StringFormat={}{0:N2} zł}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#28A745"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>