<UserControl x:Class="ZarzadzaniePrzychodniaWeterynaryjna.Views.StatystykiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Całkowity Przychód Przychodni: " Foreground="White" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CalkowityPrzychod, StringFormat={}{0:N2} zł}" Foreground="#28A745" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding ListaFaktur}" AutoGenerateColumns="False" IsReadOnly="True" RowBackground="#F9F9F9" AlternatingRowBackground="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr Wizyty" Binding="{Binding WizytaId}" Width="80"/>
                <DataGridTextColumn Header="Data Zakończenia" Binding="{Binding Data, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                <DataGridTextColumn Header="Klient" Binding="{Binding Klient}" Width="*"/>
                <DataGridTextColumn Header="Pacjent" Binding="{Binding Pacjent}" Width="*"/>
                <DataGridTextColumn Header="Kwota Brutto" Binding="{Binding Suma, StringFormat={}{0:N2} zł}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#2C3E50"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>